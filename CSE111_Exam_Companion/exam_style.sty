% Core Packages
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[margin=20mm,top=24mm,bottom=24mm,headheight=14pt]{geometry}
\RequirePackage{amsmath,amssymb,amsfonts}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}
\RequirePackage{enumitem}
\RequirePackage{fancyhdr}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{titlesec}
\RequirePackage{booktabs}
\RequirePackage{microtype}
\RequirePackage{listings}
\RequirePackage[hidelinks,colorlinks=true,linkcolor=CSNavy,urlcolor=CSCyan,citecolor=CSNavy]{hyperref}

% Color Palette for CSE111 (Computing & IT)
\definecolor{CSNavy}{RGB}{15, 32, 67}         % #0F2043 Deep Tech Navy
\definecolor{CSCyan}{RGB}{0, 128, 160}        % #0080A0 Electric Cyan
\definecolor{CSBlue}{RGB}{28, 90, 160}        % #1C5AA0 Accent Blue
\definecolor{LPUOrange}{RGB}{232, 90, 16}     % #E85A10 University Orange
\definecolor{DarkSlate}{RGB}{35, 45, 55}      % Body text
\definecolor{LightBg}{RGB}{246, 248, 252}     % Background tint
\definecolor{BorderGray}{RGB}{205, 215, 225}  % Card borders
\definecolor{SuccessGreen}{RGB}{24, 134, 75}  % Answer key / correct
\definecolor{AlertRed}{RGB}{180, 40, 40}      % Negative marking warning

% Typography & Page Setup
\color{DarkSlate}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\sffamily\color{CSNavy}\textbf{CSE111: Fundamentals of Computing \& IT} --- Exam Companion}
\fancyhead[R]{\small\sffamily\color{CSCyan}\textbf{Lovely Professional University}}
\fancyfoot[C]{\small\sffamily\thepage}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{CSNavy}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrulewidth}{0.3pt}

% Code Listing Settings
\lstset{
    basicstyle=\small\ttfamily,
    backgroundcolor=\color{LightBg},
    frame=single,
    rulecolor=\color{BorderGray},
    keywordstyle=\color{CSBlue}\bfseries,
    commentstyle=\color{gray},
    stringstyle=\color{LPUOrange},
    breaklines=true,
    showstringspaces=false
}

% Chapter & Section Formatting
\titleformat{\chapter}[display]
  {\normalfont\sffamily\huge\bfseries\color{CSNavy}}
  {\Large\color{CSCyan}\chaptertitlename\ \thechapter}{10pt}
  {\titlerule[1.5pt]\vspace{4pt}}

\titleformat{\section}
  {\normalfont\sffamily\Large\bfseries\color{CSNavy}}
  {\thesection}{1em}{}

\titleformat{\subsection}
  {\normalfont\sffamily\large\bfseries\color{CSCyan}}
  {\thesubsection}{1em}{}

% LPU-Specific Official Paper Header Box
\newcommand{\LPUCSHeader}[5]{%
  \begin{tcolorbox}[
    enhanced,
    colback=white,
    colframe=CSNavy,
    arc=2mm,
    boxrule=1.2pt,
    width=\textwidth,
    top=3mm, bottom=3mm, left=4mm, right=4mm
  ]
    \begin{center}
      {\large\sffamily\bfseries\color{CSNavy} LOVELY PROFESSIONAL UNIVERSITY (LPU)}\\[1mm]
      {\small\sffamily\bfseries School of Computer Science \& Engineering}\\[1.5mm]
      {\large\sffamily\bfseries\color{CSBlue} #1 --- SET #2}\\[2mm]
    \end{center}
    \noindent\hrulefill\\[2mm]
    \noindent
    \begin{tabularx}{\textwidth}{@{}l X r@{}}
      \textbf{Course Code:} CSE111 & \textbf{Course Title:} Fundamentals of Computing \& IT & \textbf{Time Allowed:} #3 \\
      \textbf{Max. Marks:} #4 & \textbf{Target Modules:} #5 & \textbf{Question Format:} 100\% MCQ \\
    \end{tabularx}
  \end{tcolorbox}
}

% MCQ Environment
\newcounter{mcqcount}
\newcommand{\mcqitem}[7]{%
  \noindent
  \textbf{Q.#1}\quad #2\\[1.5mm]
  \begin{enumerate}[label=(\Alph*), itemsep=0.5mm, topsep=1mm, leftmargin=8mm]
    \item #3
    \item #4
    \item #5
    \item #6
  \end{enumerate}
  \vspace{2.5mm}
}

% Solution Box Environment
\newtcolorbox{solutionbox}[1][Detailed Technical Explanation]{%
  enhanced,
  breakable,
  colback=LightBg,
  colframe=CSCyan,
  arc=1.5mm,
  boxrule=0.8pt,
  fonttitle=\bfseries\sffamily\color{white},
  coltitle=white,
  colbacktitle=CSCyan,
  title={#1},
  top=2.5mm, bottom=2.5mm, left=3.5mm, right=3.5mm
}

% Tip / Examiner Insight Box
\newtcolorbox{examinertip}[1][Examiner's Insight \& Common Pitfalls]{%
  enhanced,
  breakable,
  colback=white,
  colframe=LPUOrange,
  arc=1.5mm,
  boxrule=0.8pt,
  fonttitle=\bfseries\sffamily\color{white},
  coltitle=white,
  colbacktitle=LPUOrange,
  title={#1},
  top=2.5mm, bottom=2.5mm, left=3.5mm, right=3.5mm
}

