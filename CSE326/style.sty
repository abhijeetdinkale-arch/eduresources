% --- Listings Language Styling ---
\lstdefinelanguage{HTML5}{
    language=html,
    sensitive=true,
    alsoletter={<>=-/},
    morecomment=[s]{<!--}{-->},
    tag=[s]
}

\lstdefinelanguage{CSS3}{
    keywords={color,background,background-color,background-image,background-repeat,background-position,background-size,margin,margin-top,margin-right,margin-bottom,margin-left,padding,padding-top,padding-right,padding-bottom,padding-left,border,border-width,border-style,border-color,border-radius,border-collapse,width,height,font-family,font-size,font-weight,text-align,line-height,text-decoration,text-transform,box-sizing,display,cursor,outline},
    sensitive=false,
    morecomment=[s]{/*}{*/},
    morestring=[b]",
    morestring=[b]'
}

\lstdefinelanguage{JavaScript}{
    keywords={typeof, new, true, false, catch, function, return, null, catch, switch, var, if, in, while, do, else, case, break, const, let, document, window, console, for, continue, default, throw, try, finally, this, typeof, instanceof, arguments},
    sensitive=true,
    morecomment=[l]{//},
    morecomment=[s]{/*}{*/},
    morestring=[b]',
    morestring=[b]"
}


