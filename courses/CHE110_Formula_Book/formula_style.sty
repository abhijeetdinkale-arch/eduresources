\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[margin=18mm,top=22mm,bottom=22mm,headheight=20pt]{geometry}
\RequirePackage{amsmath,amssymb,amsfonts,mathtools,physics,bm}
