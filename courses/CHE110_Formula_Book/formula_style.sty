% Palette
\definecolor{LPUNavy}{RGB}{15, 32, 67}
\definecolor{LPUGreen}{RGB}{20, 110, 60}
\definecolor{LPUOrange}{RGB}{227, 82, 5}
\definecolor{DarkSlate}{RGB}{35, 45, 55}
\definecolor{FormulaBg}{RGB}{245, 252, 248}
\definecolor{FormulaBorder}{RGB}{20, 110, 60}
\definecolor{TipBg}{RGB}{255, 250, 235}
\definecolor{TipBorder}{RGB}{227, 82, 5}
\definecolor{LawBg}{RGB}{244, 247, 254}
\definecolor{LawBorder}{RGB}{15, 44, 89}

\RequirePackage[hidelinks,colorlinks=true,linkcolor=LPUNavy,urlcolor=LPUGreen,citecolor=LPUNavy]{hyperref}

% Header/Footer
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{LPUNavy}\textbf{CHE110: Environmental Studies --- Formula \& Reference Handbook}}
\fancyhead[R]{\small\color{LPUGreen}\textbf{\leftmark}}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\footrulewidth}{0.4pt}

% Section styling
\titleformat{\chapter}[display]
  {\normalfont\bfseries\color{LPUNavy}}
  {\Large\color{LPUGreen}\MakeUppercase{\chaptertitlename\ \thechapter}}
  {2pt}
  {\LARGE\color{LPUNavy}}
  [\vspace{3pt}{\color{LPUGreen}\rule{\linewidth}{1.5pt}}\vspace{6pt}]
\titlespacing*{\chapter}{0pt}{-10pt}{15pt}

\titleformat{\section}
  {\normalfont\large\bfseries\color{LPUNavy}}
  {\thesection}{0.8em}{}
  [\vspace{1pt}{\color{LPUGreen!40}\rule{\linewidth}{0.6pt}}]
\titlespacing*{\section}{0pt}{12pt}{6pt}

% Custom Callout Boxes
\newtcolorbox{formulabox}[1]{
    enhanced,
    breakable,
    colback=FormulaBg,
    colframe=FormulaBorder,
    coltitle=white,
    fonttitle=\bfseries\sffamily,
    title={#1},
    boxrule=0.8pt,
    arc=2mm,
    top=3mm, bottom=3mm, left=3mm, right=3mm,
    before skip=6pt, after skip=6pt
}

\newtcolorbox{lawbox}[1]{
    enhanced,
    breakable,
    colback=LawBg,
    colframe=LawBorder,
    coltitle=white,
    fonttitle=\bfseries\sffamily,
    title={#1},
    boxrule=0.8pt,
    arc=2mm,
    top=3mm, bottom=3mm, left=3mm, right=3mm,
    before skip=6pt, after skip=6pt
}

\newtcolorbox{memorytip}{
    enhanced,
    breakable,
    colback=TipBg,
    colframe=TipBorder,
    coltitle=white,
    fonttitle=\bfseries\sffamily,
    title={Examiner's High-Yield Memory Tip \& Quick Formula Shortcut},
    boxrule=0.8pt,
    arc=2mm,
    top=3mm, bottom=3mm, left=3mm, right=3mm,
    before skip=6pt, after skip=8pt
}

\endinput
