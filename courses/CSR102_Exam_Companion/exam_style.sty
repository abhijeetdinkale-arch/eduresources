\RequirePackage[hidelinks,colorlinks=true,linkcolor=LPUNavy,citecolor=LPUNavy,urlcolor=LPUOrange]{hyperref}

% Solution Box
\newtcolorbox{solutionbox}[1][]{
    enhanced,
    breakable,
    colback=SolBg,
    colframe=LPUNavy,
    coltitle=white,
    fonttitle=\bfseries\sffamily,
    title={\small Step-by-Step Analytical Solution \hfill #1},
    boxrule=0.8pt,
    arc=2mm,
    top=3mm, bottom=3mm, left=3mm, right=3mm,
    before skip=6pt, after skip=8pt
}

% Examiner Tip Box
\newtcolorbox{examinertip}[1][Examiner's Warning \& Common Pitfall]{
    enhanced,
    breakable,
    colback=white,
    colframe=LPUOrange,
    coltitle=white,
    fonttitle=\bfseries\sffamily\small,
    title={#1},
    boxrule=0.8pt,
    arc=2mm,
    top=3mm, bottom=3mm, left=3mm, right=3mm,
    before skip=6pt, after skip=8pt
}

% Marking Rubric Box
\newtcolorbox{markingrubric}{
    enhanced,
    breakable,
    colback=LightGrayBg,
    colframe=BorderGray,
    boxrule=0.6pt,
    arc=1.5mm,
    top=2mm, bottom=2mm, left=3mm, right=3mm,
    fontupper=\small\sffamily,
    before skip=4pt, after skip=6pt
}

