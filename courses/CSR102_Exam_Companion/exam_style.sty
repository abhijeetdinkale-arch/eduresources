% Colors
\definecolor{LPUOrange}{RGB}{227, 82, 5}
\definecolor{LPUNavy}{RGB}{18, 44, 82}
\definecolor{DarkSlate}{RGB}{33, 43, 54}
\definecolor{LightGrayBg}{RGB}{248, 249, 250}
