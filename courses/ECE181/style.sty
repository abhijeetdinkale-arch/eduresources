% 3. Color Palette
\RequirePackage[table,dvipsnames,svgnames]{xcolor}
\definecolor{brandnavy}{RGB}{15, 32, 67}         % LPU Navy #0F2043
\definecolor{brandblue}{RGB}{234, 88, 12}        % LPU Orange #EA580C
\definecolor{brandslate}{RGB}{71, 85, 105}       % Muted Slate
\definecolor{branddark}{RGB}{15, 23, 42}         % Slate Dark
\definecolor{brandpurple}{RGB}{126, 34, 206}     % Purple
\definecolor{brandteal}{RGB}{13, 148, 136}       % Teal Green

\definecolor{boxnavyborder}{RGB}{15, 32, 67}
\definecolor{boxnavybg}{RGB}{245, 248, 255}
\definecolor{boxamberborder}{RGB}{217, 119, 6}
\definecolor{boxamberbg}{RGB}{255, 251, 235}
\definecolor{boxgreenborder}{RGB}{13, 148, 136}
\definecolor{boxgreenbg}{RGB}{240, 253, 250}
\definecolor{boxroseborder}{RGB}{225, 29, 72}
\definecolor{boxrosebg}{RGB}{255, 241, 242}
\definecolor{boxpurplebg}{RGB}{250, 245, 255}
\definecolor{boxgrayborder}{RGB}{205, 215, 225}
\definecolor{boxgraybg}{RGB}{248, 250, 252}
\definecolor{boxgoldbg}{RGB}{254, 243, 199}

% Listings Configuration
\RequirePackage{listings}
\lstset{
    language=Python,
    basicstyle=\small\ttfamily,
    backgroundcolor=\color{boxgraybg},
    frame=single,
    rulecolor=\color{boxgrayborder},
    keywordstyle=\color{brandblue}\bfseries,
    commentstyle=\color{brandslate}\itshape,
    stringstyle=\color{brandnavy},
    breaklines=true,
    breakatwhitespace=true,
    tabsize=4,
    showstringspaces=false,
    captionpos=b
}

% 4. Callout Environments
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{skins,breakable}

\newtcolorbox{definition}[1][]{
    enhanced, breakable,
    colback=boxnavybg, colframe=boxnavyborder,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Definition}{Definition: #1}},
    boxrule=1.2pt, leftrule=4.5pt, arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=white
}

\newtcolorbox{theorem}[1][]{
    enhanced, breakable,
    colback=boxpurplebg, colframe=brandpurple,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Computational Principle / Law}{Principle: #1}},
    boxrule=1.2pt, leftrule=4.5pt, arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=white
}

\newtcolorbox{keyequation}[1][]{
    enhanced, breakable,
    colback=boxgoldbg, colframe=boxamberborder,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Core Formula / Specification}{#1}},
    boxrule=1.2pt, leftrule=4.5pt, arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=branddark
}

\newtcolorbox{methodbox}[1][]{
    enhanced, breakable,
    colback=boxgreenbg, colframe=brandteal,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Algorithmic Method / Design Heuristic}{Method: #1}},
    boxrule=1.2pt, leftrule=4.5pt, arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=white
}

\newtcolorbox{warningbox}[1][]{
    enhanced, breakable,
    colback=boxrosebg, colframe=boxroseborder,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Examiner Trap / Common Bug}{Trap: #1}},
    boxrule=1.2pt, leftrule=4.5pt, arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=white
}

\newtcolorbox{examplebox}[1][]{
    enhanced, breakable,
    colback=boxgraybg, colframe=brandslate,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Worked Example}{Example: #1}},
    boxrule=1.2pt, leftrule=4.5pt, arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=white
}

% 5. Page Layout & Headers
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\sffamily\footnotesize\thepage}
\fancyhead[RE]{\sffamily\footnotesize\nouppercase{\leftmark}}
\fancyhead[LO]{\sffamily\footnotesize\nouppercase{\rightmark}}
\renewcommand{\headrulewidth}{0.5pt}
\renewcommand{\footrulewidth}{0pt}

% Section styling
\RequirePackage{titlesec}
\titleformat{\chapter}[display]
  {\normalfont\sffamily\huge\bfseries\color{brandnavy}}
  {\chaptertitlename\ \thechapter}{15pt}{\Huge\color{brandnavy}}
\titlespacing*{\chapter}{0pt}{10pt}{20pt}

\titleformat{\section}
  {\normalfont\sffamily\Large\bfseries\color{brandnavy}}
  {\thesection}{1em}{}
\titlespacing*{\section}{0pt}{14pt}{8pt}

\titleformat{\subsection}
  {\normalfont\sffamily\large\bfseries\color{brandblue}}
  {\thesubsection}{1em}{}
\titlespacing*{\subsection}{0pt}{10pt}{5pt}

% Hyperref
\RequirePackage[hidelinks,colorlinks=true,linkcolor=brandnavy,urlcolor=brandblue,citecolor=brandnavy]{hyperref}

