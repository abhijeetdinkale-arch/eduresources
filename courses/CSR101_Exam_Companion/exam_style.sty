% Palette
\definecolor{LPUOrange}{RGB}{234, 88, 12}
\definecolor{LPUNavy}{RGB}{15, 32, 67}
\definecolor{DarkSlate}{RGB}{33, 43, 54}
\definecolor{LightGrayBg}{RGB}{248, 249, 250}
\definecolor{BorderGray}{RGB}{222, 226, 230}
\definecolor{SuccessGreen}{RGB}{40, 167, 69}
\definecolor{AlertRed}{RGB}{220, 53, 69}
\definecolor{SolBg}{RGB}{245, 248, 252}
\definecolor{SolBorder}{RGB}{180, 205, 237}

% Listings setup
\lstset{
    language=Python,
    basicstyle=\footnotesize\ttfamily,
    keywordstyle=\color{LPUNavy}\bfseries,
    stringstyle=\color{LPUOrange},
    commentstyle=\color{DarkSlate!70}\itshape,
    backgroundcolor=\color{LightGrayBg},
    frame=single,
    rulecolor=\color{BorderGray},
    tabsize=4,
    showstringspaces=false,
    breaklines=true,
    breakatwhitespace=true
}

% Solution Box
\newtcolorbox{solutionbox}[1][]{
    enhanced, breakable,
    colback=SolBg, colframe=LPUNavy, coltitle=white,
    fonttitle=\bfseries\sffamily,
    title={\small Step-by-Step Python Solution \hfill #1},
    attach boxed title to top left={yshift=-2mm, xshift=4mm},
    boxed title style={colback=LPUNavy, arc=2mm},
    boxrule=0.8pt, arc=2mm,
    top=4mm, bottom=3mm, left=3mm, right=3mm,
    separator sign none,
    before skip=8pt, after skip=10pt
}

% Examiner's Tip Box
\newtcolorbox{examinertip}[1][Examiner's Warning \& Common Pitfall]{
    enhanced, breakable,
    colback=white, colframe=LPUOrange, coltitle=white,
    fonttitle=\bfseries\sffamily\small,
    title={#1},
    attach boxed title to top left={yshift=-2mm, xshift=4mm},
    boxed title style={colback=LPUOrange, arc=2mm},
    boxrule=0.8pt, arc=2mm,
    top=3mm, bottom=3mm, left=3mm, right=3mm,
    before skip=6pt, after skip=8pt
}

% Marking Rubric Box
\newtcolorbox{markingrubric}{
    enhanced, breakable,
    colback=LightGrayBg, colframe=BorderGray,
    boxrule=0.6pt, arc=1.5mm,
    top=2mm, bottom=2mm, left=3mm, right=3mm,
    fontupper=\small\sffamily,
    before skip=4pt, after skip=6pt
}

% Header and Footer
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{LPUNavy}\textbf{CSR101: Python Programming} \textbar\ Examination Companion}
\fancyhead[R]{\small\color{LPUOrange}\textbf{\leftmark}}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\footrulewidth}{0.4pt}

% Section Titles
\titleformat{\chapter}[display]
  {\normalfont\huge\bfseries\color{LPUNavy}}{\chaptertitlename\ \thechapter}{12pt}{\Huge}
\titleformat{\section}
  {\normalfont\Large\bfseries\color{LPUNavy}}{\thesection}{1em}{}
\titleformat{\subsection}
  {\normalfont\large\bfseries\color{LPUOrange}}{\thesubsection}{1em}{}
