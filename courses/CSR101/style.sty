% Listings Configuration
\RequirePackage{listings}
\lstset{
    language=Python,
    basicstyle=\small\ttfamily,
    backgroundcolor=\color{boxgraybg},
    frame=single,
    rulecolor=\color{boxgrayborder},
    keywordstyle=\color{brandblue}\bfseries,
    commentstyle=\color{brandslate}\itshape,
    stringstyle=\color{brandnavy},
    breaklines=true,
    breakatwhitespace=true,
    tabsize=4,
    showstringspaces=false,
    captionpos=b
}

% 4. Callout Environments
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{skins,breakable}

\newtcolorbox{definition}[1][]{
    enhanced, breakable,
    colback=boxnavybg, colframe=boxnavyborder,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Definition}{Definition: #1}},
    boxrule=1.2pt, leftrule=4.5pt, arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=white
}

\newtcolorbox{theorem}[1][]{
    enhanced, breakable,
    colback=boxpurplebg, colframe=brandpurple,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Computational Principle / Law}{Principle: #1}},
    boxrule=1.2pt, leftrule=4.5pt, arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=white
}

\newtcolorbox{keyequation}[1][]{
    enhanced, breakable,
    colback=boxgoldbg, colframe=boxamberborder,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Core Architecture Formula / Identity}{#1}},
    boxrule=1.2pt, leftrule=4.5pt, arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=branddark
}

\newtcolorbox{methodbox}[1][]{
    enhanced, breakable,
    colback=boxgreenbg, colframe=brandteal,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Algorithmic Method / Design Heuristic}{Method: #1}},
    boxrule=1.2pt, leftrule=4.5pt, arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=white
}

\newtcolorbox{example}[1][]{
    enhanced, breakable,
    colback=boxskybg, colframe=boxskyborder,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Worked Example}{Worked Example: #1}},
    boxrule=1.2pt, leftrule=4.5pt, arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=white
}

\newtcolorbox{solutionbox}[1][]{
    enhanced, breakable,
    colback=boxgraybg, colframe=boxgrayborder,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Step-by-Step Analytical Solution}{#1}},
    boxrule=1.0pt, leftrule=3.5pt, arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=branddark
}

\newtcolorbox{examtip}[1][]{
    enhanced, breakable,
    colback=boxrosebg, colframe=boxroseborder,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Examiner Warning \& Common Software Trap}{Examiner Warning: #1}},
    boxrule=1.2pt, leftrule=4.5pt, arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=white
}

\newtcolorbox{summarybox}[1][]{
    enhanced, breakable,
    colback=boxnavybg, colframe=brandnavy,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Chapter Synthesis \& Key Takeaways}{#1}},
    boxrule=1.2pt, leftrule=4.5pt, arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=white
}

% 5. Header / Footer & Section Formatting
\RequirePackage{fancyhdr}
\RequirePackage{truncate}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\sffamily\color{brandslate}\textbf{CSR101} \textbar\ Python for AI \& Data Engineering}
\fancyhead[R]{\small\sffamily\color{brandnavy}\truncate{0.55\linewidth}{\nouppercase{\leftmark}}}
\fancyfoot[L]{\small\sffamily\color{brandslate}LPU Engineering Open}
\fancyfoot[R]{\small\sffamily\bfseries\color{brandblue}\thepage}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\footrulewidth}{0.4pt}

\RequirePackage{titlesec}
\titleformat{\chapter}[display]
  {\normalfont\sffamily\raggedright}
  {\color{brandblue}\large\bfseries\MakeUppercase{\chaptertitlename\ \thechapter}}
  {4pt}
  {\Huge\bfseries\color{brandnavy}}
  [\vspace{4pt}{\color{brandblue}\rule{\linewidth}{1.5pt}}\vspace{10pt}]

\titlespacing*{\chapter}{0pt}{-10pt}{20pt}

\titleformat{\section}
  {\normalfont\Large\bfseries\sffamily\color{brandnavy}}
  {\thesection}{1em}{}
  [\vspace{2pt}{\color{brandslate!40}\rule{\linewidth}{0.5pt}}]
\titlespacing*{\section}{0pt}{14pt}{6pt}

\titleformat{\subsection}
  {\normalfont\large\bfseries\sffamily\color{brandblue}}
  {\thesubsection}{0.8em}{}
\titlespacing*{\subsection}{0pt}{10pt}{4pt}

\RequirePackage{hyperref}
\hypersetup{
