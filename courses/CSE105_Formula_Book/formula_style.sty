\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{formula_style}[2026/10/22 v1.0 CSE105 Linux Cheat Sheet Style]

\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{inconsolata}
\RequirePackage[margin=16mm,top=20mm,bottom=20mm,headheight=18pt]{geometry}
\RequirePackage{amsmath,amssymb}
\RequirePackage[table,dvipsnames,svgnames]{xcolor}
\RequirePackage{booktabs,tabularx,longtable,array,multirow}
\RequirePackage{enumitem}
\RequirePackage{listings}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{microtype}
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{skins,breakable,listings}

% Palette
\definecolor{brandnavy}{RGB}{15, 32, 67}
\definecolor{brandblue}{RGB}{28, 78, 140}
\definecolor{brandteal}{RGB}{12, 115, 105}
\definecolor{brandamber}{RGB}{180, 83, 9}
\definecolor{brandaccent}{RGB}{185, 28, 28}
\definecolor{brandpurple}{RGB}{109, 40, 217}
\definecolor{terminalbg}{RGB}{24, 27, 34}
\definecolor{terminalfg}{RGB}{240, 246, 252}

\definecolor{boxnavybg}{RGB}{245, 248, 255}
\definecolor{boxtealbg}{RGB}{240, 253, 250}
\definecolor{boxamberbg}{RGB}{255, 251, 235}
\definecolor{boxrosebg}{RGB}{255, 241, 242}

% Header/Footer
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\color{brandnavy}\textbf{CSE105: Linux \& Shell Programming --- Formula \& Quick Reference Handbook}}
\fancyhead[R]{\small\color{brandteal}\textbf{\leftmark}}
\fancyfoot[C]{\sffamily\thepage}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\footrulewidth}{0.4pt}

% Section styling
\titleformat{\chapter}[display]
  {\normalfont\huge\bfseries\color{brandnavy}}{\chaptertitlename\ \thechapter}{10pt}{\Huge}
\titleformat{\section}
  {\normalfont\Large\bfseries\color{brandnavy}}{\thesection}{1em}{}
\titleformat{\subsection}
  {\normalfont\large\bfseries\color{brandteal}}{\thesubsection}{1em}{}

% Boxes
\newtcolorbox{cheatbox}[2][]{
    enhanced,
    breakable,
    colback=boxnavybg,
    colframe=brandnavy,
    fonttitle=\bfseries\color{white},
    coltitle=white,
    title={#2},
    boxrule=1pt,
    arc=2mm,
    top=2.5mm, bottom=2.5mm, left=3mm, right=3mm,
    #1
}

\newtcolorbox{syntaxbox}[2][]{
    enhanced,
    breakable,
    colback=boxtealbg,
    colframe=brandteal,
    fonttitle=\bfseries\color{white},
    coltitle=white,
    title={#2},
    boxrule=1pt,
    arc=2mm,
    top=2.5mm, bottom=2.5mm, left=3mm, right=3mm,
    #1
}

\newtcolorbox{tipbox}[1][]{
    enhanced,
    breakable,
    colback=boxamberbg,
    colframe=brandamber,
    fonttitle=\bfseries\color{brandamber},
    title={\textbf{SysAdmin Quick-Heuristic / Exam Memory Hook:}},
    boxrule=0.8pt,
    arc=2mm,
    top=2mm, bottom=2mm, left=3mm, right=3mm,
    #1
}

\newtcblisting{codebox}[1][]{
    enhanced,
    breakable,
    colback=terminalbg,
    colframe=brandnavy,
    arc=2mm,
    boxrule=1pt,
    coltext=terminalfg,
    listing only,
    listing options={
        basicstyle=\footnotesize\ttfamily\color{terminalfg},
        breaklines=true,
        columns=flexible,
        keepspaces=true,
        showstringspaces=false
    },
    title={\ifstrempty{#1}{\texttt{One-Liner Execution Pattern}}{#1}}
}

\RequirePackage[hidelinks,colorlinks=true,linkcolor=brandnavy,urlcolor=brandblue,citecolor=brandteal]{hyperref}
