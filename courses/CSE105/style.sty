% -----------------------------------------------------------------------------
% Color Palette: Linux Terminal / Unix Academic Theme
% -----------------------------------------------------------------------------
\definecolor{brandnavy}{RGB}{15, 32, 67}       % Deep Linux Navy
\definecolor{brandblue}{RGB}{28, 78, 140}      % Slate Command Blue
\definecolor{brandteal}{RGB}{12, 115, 105}     % SysAdmin Teal
\definecolor{brandaccent}{RGB}{185, 28, 28}    % Root / Alert Crimson
\definecolor{brandamber}{RGB}{180, 83, 9}      % Shell Warning Amber
\definecolor{brandpurple}{RGB}{109, 40, 217}   % Kernel Purple
\definecolor{branddark}{RGB}{24, 24, 27}       % Terminal Dark Text
\definecolor{terminalbg}{RGB}{24, 27, 34}      % Terminal Window Background
\definecolor{terminalfg}{RGB}{240, 246, 252}   % Terminal Window Text

\definecolor{boxnavybg}{RGB}{243, 247, 254}
\definecolor{boxtealbg}{RGB}{240, 253, 250}
\definecolor{boxamberbg}{RGB}{255, 251, 235}
\definecolor{boxrosebg}{RGB}{255, 241, 242}
\definecolor{boxpurplebg}{RGB}{250, 245, 255}
\definecolor{boxgraybg}{RGB}{248, 250, 252}

% -----------------------------------------------------------------------------
% Listings Setup
% -----------------------------------------------------------------------------
\lstdefinestyle{bashstyle}{
    basicstyle=\small\ttfamily\color{terminalfg},
    backgroundcolor=\color{terminalbg},
    keywordstyle=\color{cyan}\bfseries,
    commentstyle=\color{gray}\itshape,
    stringstyle=\color{lime},
    numberstyle=\tiny\color{gray},
    numbers=left,
    numbersep=8pt,
    breaklines=true,
    breakatwhitespace=true,
    columns=flexible,
    keepspaces=true,
    showstringspaces=false,
    showspaces=false,
    frame=none
}

% -----------------------------------------------------------------------------
% tcolorbox Environments
% -----------------------------------------------------------------------------
\newtcolorbox{definition}[1][]{
    enhanced,
    breakable,
    colback=boxnavybg,
    colframe=brandnavy,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Core Definition}{Definition: #1}},
    boxrule=1.2pt,
    leftrule=4.5pt,
    arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=brandnavy,
    attach title to upper={\par\vspace{4pt}},
    after title={\par\smallskip\noindent}
}

\newtcolorbox{architecturebox}[1][]{
    enhanced,
    breakable,
    colback=boxpurplebg,
    colframe=brandpurple,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{System Architecture \& Kernel Mechanics}{Architecture: #1}},
    boxrule=1.2pt,
    leftrule=4.5pt,
    arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=brandpurple,
    attach title to upper={\par\vspace{4pt}},
    after title={\par\smallskip\noindent}
}

\newtcolorbox{commandbox}[1][]{
    enhanced,
    breakable,
    colback=boxtealbg,
    colframe=brandteal,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Command Syntax \& Options}{Command Specification: #1}},
    boxrule=1.2pt,
    leftrule=4.5pt,
    arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=brandteal,
    attach title to upper={\par\vspace{4pt}},
    after title={\par\smallskip\noindent}
}

\newtcblisting{terminalbox}[1][]{
    enhanced,
    breakable,
    colback=terminalbg,
    colframe=brandnavy,
    arc=3pt,
    boxrule=1pt,
    coltext=terminalfg,
    listing only,
    listing options={
        basicstyle=\small\ttfamily\color{terminalfg},
        breaklines=true,
        columns=flexible,
        keepspaces=true,
        showstringspaces=false
    },
    title={\ifstrempty{#1}{\texttt{\$ Interactive Terminal Session}}{#1}}
}

\newtcblisting{scriptbox}[1][]{
    enhanced,
    breakable,
    colback=terminalbg,
    colframe=brandpurple,
    arc=3pt,
    boxrule=1pt,
    coltext=terminalfg,
    listing only,
    listing options={
        style=bashstyle
    },
    title={\ifstrempty{#1}{\texttt{Bash Script Execution}}{#1}}
}

\newtcolorbox{warningbox}[1][]{
    enhanced,
    breakable,
    colback=boxrosebg,
    colframe=brandaccent,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{System Pitfall \& Caution}{Warning: #1}},
    boxrule=1.2pt,
    leftrule=4.5pt,
    arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=brandaccent,
    attach title to upper={\par\vspace{4pt}},
    after title={\par\smallskip\noindent}
}

\newtcolorbox{tipbox}[1][]{
    enhanced,
    breakable,
    colback=boxamberbg,
    colframe=brandamber,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{SysAdmin Pro Tip \& Shortcut}{Pro Tip: #1}},
    boxrule=1.2pt,
    leftrule=4.5pt,
    arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=brandamber,
    attach title to upper={\par\vspace{4pt}},
    after title={\par\smallskip\noindent}
}

\newtcolorbox{examplebox}[1][]{
    enhanced,
    breakable,
    colback=boxgraybg,
    colframe=brandblue,
    fonttitle=\bfseries\sffamily,
    title={\ifstrempty{#1}{Worked Example \& Demonstration}{Example: #1}},
    boxrule=1.0pt,
    leftrule=3.5pt,
    arc=3pt,
    left=8pt, right=8pt, top=6pt, bottom=6pt,
    coltitle=brandblue,
