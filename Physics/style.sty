\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style}[2026/08/27 v1.0 LPU Engineering Open Textbook Style System]

% ==============================================================================
% 1. CORE ENCODING, FONTS & MICRO-TYPOGRAPHY
% ==============================================================================
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage{textcomp}

% ==============================================================================
% 2. PAGE GEOMETRY & LAYOUT
% ==============================================================================
\RequirePackage{geometry}
\geometry{
    a4paper,
    top=25mm,
    bottom=25mm,
    left=25mm,
    right=25mm,
    headheight=15pt,
    headsep=18pt,
    footskip=14mm
}

% ==============================================================================
% 3. MATHEMATICS, SYMBOLS & UNITS
% ==============================================================================
\RequirePackage{amsmath,amssymb,amsfonts,mathtools}
\RequirePackage{esint}
\RequirePackage{bm}
\RequirePackage{physics}
\RequirePackage{siunitx}
\sisetup{
    separate-uncertainty = true,
    inter-unit-product = \ensuremath{{}\cdot{}}
}
\AtBeginDocument{\RenewCommandCopy\qty\SI}

% ==============================================================================
% 4. COLOR PALETTE
% ==============================================================================
\RequirePackage[table,dvipsnames,svgnames]{xcolor}

\definecolor{brandnavy}{RGB}{15, 44, 89}        % Primary #0F2C59
\definecolor{brandblue}{RGB}{30, 86, 160}       % Secondary #1E56A0
\definecolor{brandslate}{RGB}{71, 85, 105}      % Muted Slate #475569
\definecolor{branddark}{RGB}{15, 23, 42}        % Text Dark #0F172A
\definecolor{brandaccent}{RGB}{217, 4, 41}      % Vivid Accent Crimson
\definecolor{brandgold}{RGB}{217, 119, 6}       % Amber Gold

\definecolor{boxnavyborder}{RGB}{15, 44, 89}
\definecolor{boxnavybg}{RGB}{243, 247, 254}

\definecolor{boxamberborder}{RGB}{217, 119, 6}
\definecolor{boxamberbg}{RGB}{255, 251, 235}

\definecolor{boxgreenborder}{RGB}{13, 148, 136}
\definecolor{boxgreenbg}{RGB}{240, 253, 250}

\definecolor{boxroseborder}{RGB}{225, 29, 72}
\definecolor{boxrosebg}{RGB}{255, 241, 242}

\definecolor{boxskyborder}{RGB}{2, 132, 199}
\definecolor{boxskybg}{RGB}{240, 249, 255}

\definecolor{boxpurpleborder}{RGB}{126, 34, 206}
\definecolor{boxpurplebg}{RGB}{250, 245, 255}

\definecolor{boxgrayborder}{RGB}{148, 163, 184}
\definecolor{boxgraybg}{RGB}{248, 250, 252}
\definecolor{boxslatebg}{RGB}{241, 245, 249}
\definecolor{boxgoldbg}{RGB}{254, 243, 199}


% ==============================================================================
% 5. BOXES & CALLOUT ENVIRONMENTS (tcolorbox)
% ==============================================================================
\RequirePackage[most]{tcolorbox}

% Global tcolorbox styling defaults
\tcbset{
    boxrule=1pt,
    arc=3pt,
    left=10pt,
    right=10pt,
    top=8pt,
    bottom=8pt,
    fonttitle=\bfseries\sffamily,
    before skip=10pt,
    after skip=10pt
}

% 1. Definition Environment
\newtcolorbox{definition}[1][Definition]{
    enhanced,
    breakable,
    colback=boxnavybg,
    colframe=boxnavyborder,
    coltitle=white,
    title={\textbf{Definition: #1}},
    boxrule=1.2pt
}

% 2. Important / Key Concept Environment
\newtcolorbox{important}[1][Important Concept]{
    enhanced,
    breakable,
    colback=boxamberbg,
    colframe=boxamberborder,
    coltitle=white,
    title={\textbf{Important: #1}},
    boxrule=1.2pt
}

% 3. Key Equation Environment
\newtcolorbox{keyequation}[1][Key Formula]{
    enhanced,
    breakable,
    colback=boxgreenbg,
    colframe=boxgreenborder,
    coltitle=white,
    title={\textbf{Key Equation: #1}},
    boxrule=1.2pt
}

% 4. Worked Example Environment
\newtcolorbox{example}[1][Worked Example]{
    enhanced,
    breakable,
    colback=boxskybg,
    colframe=boxskyborder,
    coltitle=white,
    title={\textbf{Worked Example: #1}},
    boxrule=1.2pt
}

% 5. Exam Tip Environment
\newtcolorbox{examtip}[1][Exam High-Yield Tip]{
    enhanced,
    breakable,
    colback=boxgreenbg,
    colframe=boxgreenborder,
    coltitle=white,
    title={\textbf{Exam Tip: #1}},
    boxrule=1.2pt
}

% 6. Common Mistake Environment
\newtcolorbox{commonmistake}[1][Common Student Pitfall]{
    enhanced,
    breakable,
    colback=boxrosebg,
    colframe=boxroseborder,
    coltitle=white,
    title={\textbf{Common Mistake to Avoid: #1}},
    boxrule=1.2pt
}

% 7. Quick Revision Environment
\newtcolorbox{quickrevision}[1][Quick Revision Summary]{
    enhanced,
    breakable,
    colback=boxgraybg,
    colframe=brandnavy,
    coltitle=white,
    title={\textbf{Chapter Summary: #1}},
    boxrule=1.2pt
}

% 8. Practice Set Environment
\newtcolorbox{practiceset}[1][Practice Exercises]{
    enhanced,
    breakable,
    colback=white,
    colframe=brandnavy,
    coltitle=white,
    title={\textbf{Practice Set: #1}},
    boxrule=1.2pt
}

% 9. Chapter Test Environment
\newtcolorbox{chaptertest}[1][Self-Assessment Chapter Test]{
    enhanced,
    breakable,
    colback=boxpurplebg,
    colframe=boxpurpleborder,
    coltitle=white,
    title={\textbf{Chapter Test: #1}},
    boxrule=1.2pt
}

% 10. Solution / Answer Environment
\newtcolorbox{solutionbox}[1][Solution]{
    enhanced,
    breakable,
    colback=boxgraybg,
    colframe=boxgrayborder,
    coltitle=branddark,
    title={\textbf{#1}},
    boxrule=0.8pt
}

% ==============================================================================
% 6. LISTS & ENUMERATION (enumitem)
% ==============================================================================
\RequirePackage{enumitem}
\setlist{itemsep=3pt, topsep=4pt, parsep=0pt, partopsep=0pt}
\setlist[enumerate,1]{label=\textbf{\arabic*.}, leftmargin=1.5em}
\setlist[enumerate,2]{label=(\alph*), leftmargin=1.5em}
\setlist[itemize,1]{label=\color{brandnavy}$\bullet$, leftmargin=1.5em}

% Markdown/Pandoc compatibility
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% ==============================================================================
% 7. TABLES & GRAPHICS
% ==============================================================================
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{multirow}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{shapes,arrows.meta,positioning,calc,decorations.pathmorphing,patterns}

% ==============================================================================
% 8. HEADINGS & CHAPTER STYLING (titlesec)
% ==============================================================================
\RequirePackage{titlesec}

% Chapter style: Clean numbered banner with bottom accent rule
\titleformat{\chapter}[display]
  {\normalfont\sffamily\raggedright}
  {\color{brandblue}\large\bfseries\MakeUppercase{\chaptertitlename\ \thechapter}}
  {4pt}
  {\Huge\bfseries\color{brandnavy}}
  [\vspace{4pt}{\color{brandblue}\rule{\linewidth}{1.5pt}}\vspace{10pt}]

\titlespacing*{\chapter}{0pt}{-10pt}{20pt}

\titleformat{\section}
  {\normalfont\Large\bfseries\sffamily\color{brandnavy}}
  {\thesection}{1em}{}
  [\vspace{2pt}{\color{brandslate!40}\rule{\linewidth}{0.5pt}}]

\titlespacing*{\section}{0pt}{14pt}{6pt}

\titleformat{\subsection}
  {\normalfont\large\bfseries\sffamily\color{brandblue}}
  {\thesubsection}{0.8em}{}
\titlespacing*{\subsection}{0pt}{10pt}{4pt}

\titleformat{\subsubsection}
  {\normalfont\normalsize\bfseries\sffamily\color{branddark}}
  {\thesubsubsection}{0.6em}{}
\titlespacing*{\subsubsection}{0pt}{8pt}{3pt}

% ==============================================================================
% 9. RUNNING HEADERS & FOOTERS (fancyhdr)
% ==============================================================================
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}

\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{\thesection\ #1}}

\fancyhead[L]{\small\sffamily\color{brandslate}\textbf{Engineering Physics} \textbar\ Semester 1}
\fancyhead[R]{\small\sffamily\color{brandnavy}\leftmark}
\fancyfoot[L]{\small\sffamily\color{brandslate}LPU Engineering Open}
\fancyfoot[R]{\small\sffamily\bfseries\color{brandnavy}\thepage}

\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\footrulewidth}{0.4pt}

% Plain page style (for chapter opener pages)
\fancypagestyle{plain}{
    \fancyhf{}
    \fancyfoot[L]{\small\sffamily\color{brandslate}LPU Engineering Open}
    \fancyfoot[R]{\small\sffamily\bfseries\color{brandnavy}\thepage}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0.4pt}
}

% ==============================================================================
% 10. HYPERREF & BOOKMARKS
% ==============================================================================
\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=brandblue,
    citecolor=brandnavy,
    urlcolor=brandblue,
    bookmarksnumbered=true,
    pdfpagelayout=OneColumn,
    pdfpagemode=UseOutlines
}

% ==============================================================================
% 11. FRONTMATTER MACROS: COVER, COPYRIGHT & DISCLAIMER
% ==============================================================================

