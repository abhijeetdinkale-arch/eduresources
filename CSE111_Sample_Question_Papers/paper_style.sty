% Color Palette for CSE111
\definecolor{CSNavy}{RGB}{15, 32, 67}         % Deep Navy
\definecolor{CSCyan}{RGB}{0, 128, 160}        % Tech Cyan
\definecolor{CSBlue}{RGB}{28, 90, 160}        % Accent Blue
\definecolor{LPUOrange}{RGB}{232, 90, 16}     % Accent Orange
\definecolor{DarkSlate}{RGB}{35, 45, 55}      % Body text
\definecolor{LightBg}{RGB}{246, 248, 252}     % Background tint
\definecolor{BorderGray}{RGB}{205, 215, 225}  % Card borders
\definecolor{AlertRed}{RGB}{180, 40, 40}      % Exam warnings
\definecolor{SuccessGreen}{RGB}{24, 134, 75}  % Key / Solutions

% Page Setup & Headers
\color{DarkSlate}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\sffamily\color{CSNavy}\textbf{CSE111: Orientation to Computing} --- Sample Question Papers}
\fancyhead[R]{\small\sffamily\color{CSCyan}\textbf{16-Paper Assessment Suite}}
\fancyfoot[C]{\small\sffamily\thepage}
\renewcommand{\headrulewidth}{0.6pt}
\renewcommand{\headrule}{\hbox to\headwidth{\color{CSNavy}\leaders\hrule height \headrulewidth\hfill}}
\renewcommand{\footrulewidth}{0.3pt}

% Chapter & Section Formatting
\titleformat{\chapter}[display]
  {\normalfont\sffamily\huge\bfseries\color{CSNavy}}
  {\Large\color{CSCyan}\chaptertitlename\ \thechapter}{8pt}
  {\titlerule[1.5pt]\vspace{4pt}}

\titleformat{\section}
  {\normalfont\sffamily\Large\bfseries\color{CSNavy}}
  {\thesection}{1em}{}

% Exam Paper Header Box
\newcommand{\ExamHeader}[5]{%
  \begin{tcolorbox}[
    enhanced,
    colback=white,
    colframe=CSNavy,
    arc=2mm,
    boxrule=1.2pt,
    width=\textwidth,
    top=3mm, bottom=3mm, left=4mm, right=4mm
  ]
    \begin{center}
      {\large\sffamily\bfseries\color{CSNavy} LOVELY PROFESSIONAL UNIVERSITY}\\[1mm]
      {\small\sffamily\bfseries Department of Computer Science \& Engineering}\\[1.5mm]
      {\large\sffamily\bfseries\color{CSBlue} #1 --- SET #2}\\[2mm]
    \end{center}
    \noindent\hrulefill\\[2mm]
    \noindent
    \small\sffamily
    \begin{tabular}{@{}l p{7.5cm} r@{}}
      \textbf{Course Code:} CSE111 & \textbf{Title:} Orientation to Computing & \textbf{Time Allowed:} #3 \\
      \textbf{Max. Marks:} #4 & \textbf{Syllabus Scope:} #5 & \textbf{Format:} 100\% MCQ \\
    \end{tabular}
  \end{tcolorbox}
  \vspace{2mm}
}

% MCQ Item
\newcommand{\mcqitem}[6]{%
  \noindent
  \textbf{Q.#1}\quad #2\\[1.5mm]
  \begin{enumerate}[label=(\Alph*), itemsep=0.5mm, topsep=1mm, leftmargin=8mm]
    \item #3
    \item #4
    \item #5
    \item #6
  \end{enumerate}
  \vspace{2mm}
}

% Answer Key Table Environment
\newenvironment{answerkeytable}[1]{%
  \begin{tcolorbox}[enhanced, colback=white, colframe=CSNavy, arc=2mm, boxrule=1pt, title={\textbf{#1}}, fonttitle=\bfseries\sffamily\color{white}, colbacktitle=CSNavy]
  \centering
  \small\sffamily
}{%
  \end{tcolorbox}
}

% Explanation Box
\newtcolorbox{expbox}[1][Answer Key \& Explanations]{%
  enhanced,
  breakable,
  colback=LightBg,
  colframe=CSCyan,
  arc=1.5mm,
  boxrule=0.8pt,
  fonttitle=\bfseries\sffamily\color{white},
  coltitle=white,
  colbacktitle=CSCyan,
  title={#1},
  top=2.5mm, bottom=2.5mm, left=3.5mm, right=3.5mm
}

\endinput
