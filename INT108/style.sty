% Custom Listing Configuration for Python
\lstdefinelanguage{Python3}{
    language=Python,
    keywords={False,None,True,and,as,assert,async,await,break,class,continue,def,del,elif,else,except,finally,for,from,global,if,import,in,is,lambda,nonlocal,not,or,pass,raise,return,try,while,with,yield,match,case},
    keywordstyle=\color{pykeyword}\bfseries,
    emph={int,float,str,bool,list,tuple,dict,set,len,print,range,type,input,open,sum,min,max,abs,round,isinstance,issubclass,super,id,enumerate,zip,map,filter,sorted,reversed},
    emphstyle=\color{pybuiltin}\bfseries,
    commentstyle=\color{pycomment}\itshape,
    stringstyle=\color{pystring},
    basicstyle=\small\ttfamily\color{pycodefg},
    numbers=left,
    numberstyle=\tiny\color{slate!50!white},
    stepnumber=1,
    numbersep=8pt,
    tabsize=4,
    showstringspaces=false,
    breaklines=true,
    breakatwhitespace=true,
    frame=none,
    columns=fullflexible,
    keepspaces=true,
    xleftmargin=1.5em
}

% Global defaults for all tcolorboxes
\tcbset{
    boxrule=1pt,
    arc=3pt,
    left=10pt,
    right=10pt,
    top=8pt,
    bottom=8pt,
    fonttitle=\bfseries\sffamily,
    before skip=10pt,
    after skip=10pt
}

% 1. Python Code Environment
