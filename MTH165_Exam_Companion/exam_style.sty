% Official LPU Exam Header Box
% Arguments: {Exam Type}{Set}{Time}{Max Marks}{CO Info}
\newcommand{\LPUPaperHeader}[5]{
    \noindent
    \begin{tcolorbox}[enhanced, colback=white, colframe=LPUNavy, boxrule=1pt, arc=1.5mm, left=2mm, right=2mm, top=2mm, bottom=2mm]
    \begin{tabularx}{\textwidth}{@{}X r@{}}
        \begin{tabular}{@{}l@{}}
            {\Large\bfseries\color{LPUNavy} LOVELY PROFESSIONAL UNIVERSITY} \\[1mm]
            {\footnotesize\sffamily\color{gray} Transforming Education, Transforming India} \\[2mm]
            {\textbf{Course Code:}} MTH-165 \quad {\textbf{Course Title:}} Mathematics for Engineers \\
            {\textbf{Academic Task Type:}} #1 \quad {\textbf{Set:}} \textbf{\color{LPUOrange}#2} \\
            {\textbf{Maximum Marks:}} #4 \quad {\textbf{Time Allowed:}} #3
        \end{tabular}
        &
        \begin{tabular}{|p{4.2cm}|}
            \hline
            {\footnotesize\textbf{Roll No.:}} \dotfill \\[2mm]
            {\footnotesize\textbf{Reg. No.:}} \dotfill \\[2mm]
            {\footnotesize\textbf{Section:}} \dotfill \\
            \hline
        \end{tabular}
    \end{tabularx}
    \vspace{1mm}
    \hrule height 0.5pt
    \vspace{1.5mm}
    \noindent{\footnotesize\sffamily\textbf{Course Outcomes Addressed:} #5}
    \end{tcolorbox}
    \vspace{2mm}
}

% Question environment with metadata
\newcommand{\questionitem}[5]{
    % #1: Q Number, #2: Statement, #3: Marks, #4: CO, #5: Bloom's Level
    \noindent
    \begin{minipage}{\textwidth}
    \vspace{2mm}
    \begin{tcolorbox}[enhanced, colback=white, colframe=BorderGray, boxrule=0.6pt, arc=1mm, top=2mm, bottom=2mm, left=2.5mm, right=2.5mm]
    \begin{tabularx}{\textwidth}{@{}p{1.2cm} X p{2.2cm} p{1.6cm} p{1.4cm}@{}}
        \textbf{Q.#1} & #2 & {\footnotesize\color{LPUNavy}\textbf{#4}} & {\footnotesize\color{DarkSlate}#5} & {\bfseries\color{LPUOrange}#3 Marks}
    \end{tabularx}
    \end{tcolorbox}
    \end{minipage}
}

% MCQ question item
\newcommand{\mcqitem}[7]{
    % #1: Q No, #2: Question text, #3: (A), #4: (B), #5: (C), #6: (D), #7: Marks
    \noindent
    \parbox{\textwidth}{
        \vspace{2mm}
        \textbf{Q.#1} \quad #2 \hfill {\footnotesize\color{LPUOrange}\bfseries [#7 Mark\ifnum#7>1s\fi]}
        \vspace{1mm}
        \begin{multicols}{2}
        \begin{enumerate}[label=(\Alph*), leftmargin=6mm, itemsep=1pt]
            \item #3
            \item #4
            \item #5
            \item #6
        \end{enumerate}
        \end{multicols}
    }
}

