{
  "version": 2,
  "builds": [
    {
      "src": "viewer-platform/server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "viewer-platform/client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "viewer-platform/server/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "viewer-platform/client/$1"
    }
  ]
}
