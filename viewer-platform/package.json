{
  "name": "edunetwork-desktop",
  "version": "1.0.0",
  "description": "Edu network • Academic Material & Book Archives with Hardware-level DRM",
  "main": "desktop/main.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "desktop:run": "electron desktop/main.js",
    "desktop:build:mac": "npm run build && electron-builder --mac --arm64",
    "desktop:build:win": "npm run build && electron-builder --win",
    "start": "node server/index.js"
  },
  "build": {
    "appId": "com.edunetwork.desktop",
    "productName": "EduNetwork",
    "files": [
      "desktop/**/*",
      "server/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "desktop/icon.icns",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "desktop/icon.ico",
      "target": ["portable", "dir"]
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.11.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  }
}
