# Secure Study Material & Book Viewer Configuration

# Port for Express API server
PORT=5001

# JWT Secret for session & stream tokens (change in production)
JWT_SECRET=super_secure_random_jwt_secret_key_here_12345

# Google OAuth 2.0 Web Client ID (from https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=

# Environment ('development' or 'production')
NODE_ENV=development
